# ==========================================
# Cloudinary Configuration
# Obtain your credentials from https://cloudinary.com/console
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# (Optional) Alternative single-line Cloudinary URL
# CLOUDINARY_URL=cloudinary://my_key:my_secret@my_cloud_name

# ==========================================
# MongoDB Configuration
# ==========================================
MONGODB_USERNAME="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/noir?retryWrites=true&w=majority"

# ==========================================
# SSLCOMMERZ Payment Gateway Configuration
# Obtain credentials from https://developer.sslcommerz.com/
# ==========================================
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sslcommerz_store_password"
SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"